diff --git a/src/page.setup/components/settings.appearance.vue b/src/page.setup/components/settings.appearance.vue
--- a/src/page.setup/components/settings.appearance.vue
+++ b/src/page.setup/components/settings.appearance.vue
@@ -56,7 +56,7 @@
     v-model:value="Settings.state.colorScheme"
