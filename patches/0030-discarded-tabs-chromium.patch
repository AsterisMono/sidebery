# Emulate Firefox-only discarded/title tab creation and remove string-code injection.
diff --git a/src/services/tabs.fg.ts b/src/services/tabs.fg.ts
--- a/src/services/tabs.fg.ts
+++ b/src/services/tabs.fg.ts
@@ -1,2 +1,3 @@
 import * as T from 'src/types'
+import { prepareTabForForceDiscard } from 'src/platform/force-discard'
 import { TabStatus, LoadSrc, Err } from 'src/enums'
@@ -1160,15 +1161,7 @@ export async function discardTabs(ids: ID[]): Promise<void> {
 
   // Try to reset closing prevention and discard such tabs
   if (Settings.state.forceDiscard && Permissions.allUrls && secondTryIds.length) {
-    const forceDiscardInjection =
-      'window.onbeforeunload=null;window.addEventListener("beforeunload", e => {e.returnValue=""})'
     await Promise.allSettled(
-      secondTryIds.map(id => {
-        return browser.tabs.executeScript(id, {
-          code: forceDiscardInjection,
-          runAt: 'document_start',
-          allFrames: true,
-        })
-      })
+      secondTryIds.map(id => prepareTabForForceDiscard(id))
     )
 
