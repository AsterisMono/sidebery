# Chromium removes webRequest/webRequestBlocking/proxy and has no tabHide, so treat
# those permissions as unavailable, derive "web data" access from host origins alone,
# and hide the Firefox-only native tab-hiding permission toggle.
diff --git a/src/services/permissions.ts b/src/services/permissions.ts
--- a/src/services/permissions.ts
+++ b/src/services/permissions.ts
@@ -36,9 +36,9 @@ export async function load(): Promise<void> {
   const perms = await Promise.all([
     browser.permissions.contains({ origins: ['<all_urls>'] }),
-    browser.permissions.contains({ permissions: ['webRequest'] }),
-    browser.permissions.contains({ permissions: ['webRequestBlocking'] }),
-    browser.permissions.contains({ permissions: ['proxy'] }),
-    browser.permissions.contains({ permissions: ['tabHide'] }),
+    Promise.resolve(false), // webRequest is removed on Chromium
+    Promise.resolve(false), // webRequestBlocking is removed on Chromium
+    Promise.resolve(false), // proxy is removed on Chromium
+    Promise.resolve(false), // tabHide is Firefox-only
     browser.permissions.contains({ permissions: ['clipboardWrite'] }),
     browser.permissions.contains({ permissions: ['clipboardRead'] }),
     browser.permissions.contains({ permissions: ['history'] }),
@@ -66,7 +66,7 @@ export async function load(): Promise<void> {
   bookmarks = perms[8]
   downloads = perms[9]
 
-  reactive.webData = allUrls && webRequest && webRequestBlocking && proxy
+  reactive.webData = allUrls
   reactive.tabHide = Permissions.tabHide
   reactive.clipboardWrite = Permissions.clipboardWrite
   reactive.clipboardRead = Permissions.clipboardRead
@@ -96,7 +96,6 @@ export async function _request(...perms: RequestablePermission[]): Promise<boolean> {
 
   if (perms.includes('<all_urls>')) {
     origins.push('<all_urls>')
-    permissions.push('webRequest', 'webRequestBlocking', 'proxy')
     Utils.rmFromArray(perms, '<all_urls>')
   }
 
