+const LEGACY_SYNC_NOTICE_KEY = 'chromiumLegacySyncPanelNoticeShown'
+
+async function handleSanitizedSidebarConfig(
+  sidebar: T.SidebarConfig,
+  result: ChromiumSidebarSanitization,
+  persist: boolean
+): Promise<void> {
+  const changed = Object.values(result).some(count => count > 0)
+  if (changed && persist) await browser.storage.local.set({ sidebar })
+  if (!result.removedSyncPanels) return
+
+  const stored = await browser.storage.local.get<Record<string, boolean>>(LEGACY_SYNC_NOTICE_KEY)
+  if (stored[LEGACY_SYNC_NOTICE_KEY]) return
+
+  Notifications.notify({
+    id: 'chromium-sync-panels-removed',
+    icon: '#icon_sync',
+    title: 'Sync panels were removed',
+    details: 'Sync is not available in the Chromium build.',
+  })
+  await browser.storage.local.set({ [LEGACY_SYNC_NOTICE_KEY]: true })
+}
+
+async function sanitizeLoadedSidebarConfig(
+  storage: T.Stored,
+  persist: boolean
+): Promise<void> {
+  if (!storage.sidebar) return
+  const result = sanitizeSidebarConfigForChromium(storage.sidebar)
+  await handleSanitizedSidebarConfig(storage.sidebar, result, persist)
+}
+
 async function loadSidebarConfig() {
   const msp = browser.storage.managed.get<T.Stored>('sidebar').catch(() => undefined)
   const psp = browser.storage.local.get<T.Stored>('lastFocusedActivePanelId').catch(() => undefined)
@@ -195,11 +227,13 @@ async function loadSidebarConfig() {
 
   const [ms, ps, ls] = await Promise.all([msp, psp, lsp])
   if (ms?.sidebar) {
+    await sanitizeLoadedSidebarConfig(ms, false)
     if (ps?.lastFocusedActivePanelId) Object.assign(ms, ps)
     return ms
   }
 
   if (ls?.sidebar) {
+    await sanitizeLoadedSidebarConfig(ls, true)
     if (ps?.lastFocusedActivePanelId) Object.assign(ls, ps)
     return ls
   }
