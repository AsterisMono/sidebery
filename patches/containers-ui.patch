+export function sanitizeCtxMenu(conf: T.MenuConfs): T.MenuConfs {
+  const sanitize = (menu?: T.MenuConf): T.MenuConf | undefined =>
+    menu?.reduce<T.MenuConf>((result, entry) => {
+      if (typeof entry === 'string') {
+        if (!UNSUPPORTED_MENU_OPTIONS.has(entry)) result.push(entry)
+      } else {
+        const opts = entry.opts.filter(opt => !UNSUPPORTED_MENU_OPTIONS.has(opt))
+        if (opts.length) result.push({ ...entry, opts })
+      }
+      return result
+    }, [])
+
