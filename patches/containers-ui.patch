+    tabs: sanitize(conf.tabs),
+    tabsPanel: sanitize(conf.tabsPanel),
+    bookmarks: sanitize(conf.bookmarks),
+    bookmarksPanel: sanitize(conf.bookmarksPanel),
+  }
