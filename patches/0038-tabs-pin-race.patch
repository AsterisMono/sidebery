+/**
+ * Tabs.onReplaced
+ *
+ * Chromium can replace a tab's WebContents while discarding it. The native
+ * tab then gets a new id without onRemoved/onCreated, so migrate every live
+ * Sidebery reference before Chromium sends onUpdated for the new id.
+ */
+function onTabReplaced(addedTabId: ID, removedTabId: ID): void {
+  if (!Tabs.ready || waitForOtherReopenedTabsBuffer || Tabs.sorting) {
+    Tabs.deferredEventHandling.push(() => onTabReplaced(addedTabId, removedTabId))
+    return
+  }
+
+  const replacedTab = Tabs.byId[removedTabId]
+  if (!replacedTab) return
+  if (Tabs.byId[addedTabId]) return Tabs.reinitTabs()
+
+  if (Selection.selected.has(removedTabId)) Selection.resetSelection()
+  IPPC.reset(replacedTab)
+  Preview.resetTargetTab(removedTabId, 0)
+
+  const tab = replaceTabId(Tabs.byId, Tabs.list, addedTabId, removedTabId) as Tab
+  if (tab.sessionData) tab.sessionData.id = addedTabId
+
+  replaceId(Tabs.movingTabs, removedTabId, addedTabId)
+  replaceId(Tabs.removingTabs, removedTabId, addedTabId)
+  replaceId(Tabs.activeTabsGlobal.actTabs, removedTabId, addedTabId)
+  for (const history of Object.values(Tabs.activeTabsPerPanel)) {
+    replaceId(history.actTabs, removedTabId, addedTabId)
+  }
+  for (const position of Object.values(Tabs.newTabsPosition)) {
+    if (position.parent === removedTabId) position.parent = addedTabId
+  }
+  for (const removedTab of Tabs.removedTabs) {
+    if (removedTab.parentId === removedTabId) removedTab.parentId = addedTabId
+    if (removedTab.children) replaceId(removedTab.children, removedTabId, addedTabId)
+  }
+
+  if (Tabs.detachingTabIds.delete(removedTabId)) Tabs.detachingTabIds.add(addedTabId)
+  if (Tabs.activeId === removedTabId) Tabs.setActiveId(addedTabId)
+  if (deferredActivationHandling.id === removedTabId) deferredActivationHandling.id = addedTabId
+
+  Sidebar.recalcTabsPanels(true)
+  Sidebar.recalcVisibleTabs()
+  Tabs.updateTabsTree()
+  Tabs.saveTabData(addedTabId, true)
+  Tabs.cacheTabsData()
+  browser.sessions.removeTabValue(removedTabId, 'data').catch(() => {})
+}
