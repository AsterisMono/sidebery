+/**
+ * Handle Chromium WebContents replacement (including tab discard).
+ */
+function onTabReplaced(addedTabId: ID, removedTabId: ID): void {
+  if (!Tabs.ready) {
+    Tabs.deferredEventHandling.push(() => onTabReplaced(addedTabId, removedTabId))
+    return
+  }
+
+  const replacedTab = Tabs.byId[removedTabId]
+  if (!replacedTab) return
+  if (Tabs.byId[addedTabId]) {
+    void reinitTabs('onTabReplaced: Added tab already exists')
+    return
+  }
+
+  IPPC.reset(replacedTab)
+  const tab = replaceTabId(
+    Tabs.byId,
+    Object.values(Tabs.byId),
+    addedTabId,
+    removedTabId
+  ) as T.BgTab
+
+  const tabWindow = Windows.byId.get(tab.windowId)
+  if (tabWindow?.activeTabId === removedTabId) tabWindow.activeTabId = addedTabId
+  if (tab.proxified) showProxyBadge(addedTabId)
+}
