+async function blobToDataUrl(blob: Blob): Promise<string> {
+  const text = await blob.text()
+  const type = blob.type || 'text/plain'
+  return `data:${type};charset=utf-8,${encodeURIComponent(text)}`
+}
+
+export async function exportSnapshot(snapshot: NormalizedSnapshot): Promise<void> {
+  if (!browser?.downloads) return
+
+  try {
+    const expType = Settings.state.snapAutoExportType
+    const expInfo = prepareExport(snapshot, {
+      JSON: expType === 'json' || expType === 'both',
+      Markdown: expType === 'md' || expType === 'both',
+    })
+    const path = getExportPath(expInfo)
+
+    if (expInfo.jsonFile) {
+      await browser.downloads.download({
+        url: await blobToDataUrl(expInfo.jsonFile),
+        filename: `${path}.json`,
+        conflictAction: 'overwrite',
+        saveAs: false,
+      })
+    }
+
+    if (expInfo.mdFile) {
+      await browser.downloads.download({
+        url: await blobToDataUrl(expInfo.mdFile),
+        filename: `${path}.md`,
+        conflictAction: 'overwrite',
+        saveAs: false,
+      })
+    }
+  } catch (error) {
+    Logs.err('Snapshots.exportSnapshot: Cannot export snapshot', error)
+  }
+}
