# Route Chromium extension pages through the default context and native
# extension messaging, which wakes the MV3 service worker when needed.
diff --git a/src/services/ippc.addon.ts b/src/services/ippc.addon.ts
index e1ff8547..b5cdd09a 100644
--- a/src/services/ippc.addon.ts
+++ b/src/services/ippc.addon.ts
@@ -1,9 +1,7 @@
 import type * as T from 'src/types'
-import * as D from 'src/defaults'
 import { InstanceType } from 'src/enums'
 import { uid } from 'src/utils'
 import * as Logs from 'src/services/logs'
 import * as IPC from 'src/services/ipc'
 import * as IPPC from 'src/services/ippc'
-import { sendHashMsg } from 'src/services/ippc.addon.hm'
 import { Channels, sendBCMsg } from 'src/services/ippc.addon.bc'
@@ -93,7 +91,5 @@ async function answer<T extends InstanceType, A extends T.ActionsKeys<T>>(
 ) {
